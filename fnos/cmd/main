#!/bin/bash

APP_DIR="${TRIM_APPDEST}"
VAR_DIR="${TRIM_PKGVAR}"
PID_FILE="${VAR_DIR}/pansou.pid"
LOG_FILE="${VAR_DIR}/pansou.log"
SOCKET_FILE="${APP_DIR}/app.sock"

running() {
  [ -f "$PID_FILE" ] || return 1
  local pid
  pid="$(cat "$PID_FILE")"
  [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null
}

start_app() {
  if running; then return 0; fi
  mkdir -p "$VAR_DIR/cache"
  rm -f "$PID_FILE" "$SOCKET_FILE"

  set -a
  . "${APP_DIR}/defaults.env"
  if [ -f "${TRIM_PKGETC}/pansou.env" ]; then
    . "${TRIM_PKGETC}/pansou.env"
  fi
  set +a
  export CACHE_PATH="${VAR_DIR}/cache"
  export FRONTEND_DIST="${APP_DIR}/web"
  export GATEWAY_PREFIX="/app/pansou"
  export SOCKET_PATH="$SOCKET_FILE"
  export TZ="Asia/Shanghai"

  "${APP_DIR}/pansou" >> "$LOG_FILE" 2>&1 &
  echo "$!" > "$PID_FILE"
  for _ in {1..20}; do
    if [ -S "$SOCKET_FILE" ] && running; then return 0; fi
    if ! running; then break; fi
    sleep 0.25
  done
  echo "PanSou 启动失败，请查看 ${LOG_FILE}" > "${TRIM_TEMP_LOGFILE:-/dev/stderr}"
  rm -f "$PID_FILE"
  return 1
}

stop_app() {
  if running; then
    local pid
    pid="$(cat "$PID_FILE")"
    kill -TERM "$pid" 2>/dev/null || true
    for _ in {1..80}; do
      if ! kill -0 "$pid" 2>/dev/null; then break; fi
      sleep 0.25
    done
    if kill -0 "$pid" 2>/dev/null; then kill -KILL "$pid" 2>/dev/null || true; fi
  fi
  rm -f "$PID_FILE" "$SOCKET_FILE"
}

case "$1" in
  start) start_app ;;
  stop) stop_app ;;
  status) if running && [ -S "$SOCKET_FILE" ]; then exit 0; else exit 3; fi ;;
  *) exit 1 ;;
esac
